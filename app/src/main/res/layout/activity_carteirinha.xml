<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CarteirinhaActivity">

    <TextView
        android:id="@+id/txtBenefEstudantis"
        android:layout_width="370sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Apresente as seguintes imagens em cinemas, shows ou eventos para usufruir de seus benefícios estudantis."
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgbtnVoltarCarteirinha" />

    <ImageButton
        android:id="@+id/imgbtnVoltarCarteirinha"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="#00FFFFFF"
        android:contentDescription="Botão Voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_back_alt" />

</androidx.constraintlayout.widget.ConstraintLayout>
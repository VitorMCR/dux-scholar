<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".StudentProfileActivity">

    <com.example.duxscholar.TopBarView
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDataHeader"
        android:layout_width="350sp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:text="@string/studentprofileactivity_datatitle"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/txtDataLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRematricula" />

    <TextView
        android:id="@+id/txtDataLabel"
        android:layout_width="80sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="18sp"
        android:text="@string/studentprofileactivity_datalist"
        android:textAlignment="textEnd"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtDataHeader" />

    <TextView
        android:id="@+id/txtDataLabelValues"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="18sp"
        android:textAlignment="textStart"
        app:layout_constraintStart_toEndOf="@+id/txtDataLabel"
        app:layout_constraintTop_toBottomOf="@+id/txtDataHeader" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnStuCarteirinha"
            android:layout_width="110sp"
            android:layout_height="90sp"
            android:background="@drawable/bg_card_services"
            android:drawableTop="@drawable/ic_carteirinha"
            android:text="Carteirinha"
            android:textAlignment="center"
            android:textColor="@color/textColor"
            android:textSize="10sp"
            app:backgroundTint="@null" />

        <Space
            android:layout_width="12sp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnNotasFaltas"
            android:layout_width="110sp"
            android:layout_height="90sp"
            android:background="@drawable/bg_card_services"
            android:drawableTop="@drawable/ic_gradeabsences"
            android:text="Notas/Faltas"
            android:textAlignment="center"
            android:textColor="@color/textColor"
            android:textSize="10sp"
            app:backgroundTint="@null" />

        <Space
            android:layout_width="12sp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnHorarios"
            android:layout_width="110sp"
            android:layout_height="90sp"
            android:background="@drawable/bg_card_services"
            android:drawableTop="@drawable/ic_clock"
            android:text="Horários"
            android:textAlignment="center"
            android:textColor="@color/textColor"
            android:textSize="10sp"
            app:backgroundTint="@null" />

    </LinearLayout>

    <Button
        android:id="@+id/btnRematricula"
        android:layout_width="350sp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#928D9B"
        android:drawableStart="@drawable/ic_blocked"
        android:text="Rematrícula"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:icon="@drawable/ic_blocked"
        app:iconPadding="-16dp"
        app:iconTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

    <com.example.duxscholar.NavbarView
        android:id="@+id/navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>